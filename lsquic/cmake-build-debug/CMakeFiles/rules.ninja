rule RERUN_CMAKE
  command = /home/cnic/下载/clion-2023.3.4/bin/cmake/linux/x64/bin/cmake --regenerate-during-build -S/home/cnic/project/lzj/lsquic -B/home/cnic/project/lzj/lsquic/cmake-build-debug
  description = Re-running CMake...
  generator = 1


